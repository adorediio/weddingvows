        {
          "id": "r4_01",
          "label": "Match his volume",
          "reason": "Unreasonable Behaviour",
          "weight": 1,
          "tension": 1,
          "next": "r4_s2a"
        },
        {
          "id": "r4_02",
          "label": "Keep your voice low and ask him to stop",
          "reason": null,
          "weight": 0,
          "tension": 0,
          "next": "r4_s2b"
        },
        {
          "id": "r4_03",
          "label": "Walk into another room",
          "reason": null,
          "weight": 0,
          "tension": 0,
          "next": "r4_s2c"
        }
      ]
    },
    "r4_s2a": {
      "text": "“Liar.” The word lands first, then others, each one louder than the last. You stop hearing what he is saying and only hear how loudly he says it.",
